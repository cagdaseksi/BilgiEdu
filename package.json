{
  "name": "BilgiEdu",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "participants": "node scripts/generate-participants.mjs",
    "postinstall": "npm run participants",
    "prestart": "npm run participants",
    "preandroid": "npm run participants",
    "preios": "npm run participants",
    "pretest": "npm run participants",
    "typecheck": "npm run participants && tsc --noEmit",
    "test:scope": "node --test scripts/check-participant-scope.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test -- --runInBand && npm run test:scope",
    "android:release": "cd android && ./gradlew bundleRelease assembleRelease",
    "participant:add": "node scripts/add-participant.mjs",
    "ios:archive": "npm run participants && node scripts/with-ios-signing.mjs archive",
    "ios:export": "node scripts/with-ios-signing.mjs export",
    "ios:upload": "node --env-file=.release.env scripts/upload-testflight.mjs"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "^5.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3",
    "@react-native/jest-preset": "0.86.0"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
